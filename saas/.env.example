# ==============================================================================
# Backend (.env.example) - Safari OS SaaS Backend
# Copy this file to .env and configure for your local environment or production.
# ==============================================================================

# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/saas_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password

# JWT Authentication
JWT_SECRET=your_base64_encoded_32_plus_character_secure_jwt_secret_key
JWT_EXPIRATION=3600000

# Email (SMTP / IMAP) Configuration
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password

# Gemini Studio AI Document Reader
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# DATA SEEDING & SECURITY ENVIRONMENT CONTROLS
# ==============================================================================
# CRITICAL SECURITY NOTE FOR PRODUCTION HOSTING:
# 1. When hosting on production/cloud, ALWAYS keep APP_SEED_ENABLED=false.
#    Leaving this true exposes default test accounts and demo data.
# 2. To initialize a brand new production instance:
#    - Set APP_SEED_ENABLED=true
#    - Set APP_SEED_SAMPLE_DATA=false (only creates roles, plans, and Super Admin)
#    - Provide a strong, unique APP_SEED_SUPER_ADMIN_PASSWORD
#    - Run once, then immediately switch APP_SEED_ENABLED=false!

APP_SEED_ENABLED=false
APP_SEED_SAMPLE_DATA=false
APP_SEED_DEFAULT_PASSWORD=ChangeThisPassword123!
APP_SEED_SUPER_ADMIN_EMAIL=superadmin@platform.com
APP_SEED_SUPER_ADMIN_PASSWORD=SetYourStrongSuperAdminPasswordHere!
APP_SEED_SUPER_ADMIN_FIRST_NAME=Platform
APP_SEED_SUPER_ADMIN_LAST_NAME=SuperAdmin
APP_SEED_SUPER_ADMIN_PHONE=+255700000001

# ==============================================================================
# FILE STORAGE CONFIGURATION (LOCAL vs CLOUDFLARE R2 OBJECT STORAGE)
# ==============================================================================
# Options:
#   - 'local' : Saves files to local directory (ideal for local development)
#   - 'r2'    : Uses Cloudflare R2 Object Storage (recommended for production hosting
#               so uploaded files and invoices are not lost when containers restart)
STORAGE_TYPE=local
UPLOAD_DIR=uploads

# Cloudflare R2 Object Storage Credentials (required only when STORAGE_TYPE=r2):
# Obtain these from Cloudflare Dashboard -> R2 Object Storage -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id_hex
R2_BUCKET_NAME=your_r2_bucket_name
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Optional custom public domain (e.g. https://media.yourdomain.com or https://pub-xxx.r2.dev)
R2_PUBLIC_URL=
# Optional custom endpoint (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=

# ==============================================================================
# CORS (Cross-Origin Resource Sharing) CONFIGURATION
# ==============================================================================
# Comma-separated list of origins allowed to access the backend API.
# In local development: http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# In production: https://app.yourdomain.com,https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS,HEAD
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=Authorization,Content-Disposition,Link,X-Total-Count
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

