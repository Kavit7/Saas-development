# ==============================================================================
# Safari Sales OS - Root Docker Environment Template (.env.example)
# Copy this file to .env before running: docker compose up -d --build
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_DB=saas_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_postgres_password_here
DB_PORT=5432

# ------------------------------------------------------------------------------
# 2. Application Ports
# ------------------------------------------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=5173

# ------------------------------------------------------------------------------
# 3. Security & JWT Configuration
# ------------------------------------------------------------------------------
# Generate a strong 256-bit secret key (e.g. openssl rand -base64 32)
JWT_SECRET=your_super_secret_base64_jwt_key_minimum_32_characters_long
JWT_EXPIRATION=3600000

# ------------------------------------------------------------------------------
# 4. DATA SEEDING & HOSTING SECURITY (CRITICAL)
# ------------------------------------------------------------------------------
# In PRODUCTION / HOSTING:
#   - Keep APP_SEED_ENABLED=false at all times once the database is initialized.
#   - If this is a fresh database and you want to initialize essential roles
#     and your initial Super Admin:
#       1. Set APP_SEED_ENABLED=true
#       2. Set APP_SEED_SAMPLE_DATA=false (prevents creating mock companies/test clients)
#       3. Set APP_SEED_SUPER_ADMIN_EMAIL=your-real-admin@yourdomain.com
#       4. Set APP_SEED_SUPER_ADMIN_PASSWORD=YourStrongUniquePassword!
#       5. Start the backend once.
#       6. Immediately change APP_SEED_ENABLED=false so subsequent restarts are secure.
#
# In LOCAL DEVELOPMENT:
#   - Set APP_SEED_ENABLED=true
#   - Set APP_SEED_SAMPLE_DATA=true (creates demo companies, clients, and role users)
#   - APP_SEED_DEFAULT_PASSWORD=Password123!
APP_SEED_ENABLED=false
APP_SEED_SAMPLE_DATA=false
APP_SEED_DEFAULT_PASSWORD=ChangeThisPassword123!
APP_SEED_SUPER_ADMIN_EMAIL=superadmin@platform.com
APP_SEED_SUPER_ADMIN_PASSWORD=SetAStrongPasswordHere123!

# ------------------------------------------------------------------------------
# 5. File Storage Configuration (Local Disk vs Cloudflare R2 Object Storage)
# ------------------------------------------------------------------------------
# Set to 'local' for local development uploads, or 'r2' for Cloudflare Object Storage
STORAGE_TYPE=local
UPLOAD_DIR=uploads

# Cloudflare R2 Credentials (required when STORAGE_TYPE=r2):
# Created in Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=your_r2_bucket_name
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Optional public domain (e.g. https://media.yourdomain.com or https://pub-xxx.r2.dev)
R2_PUBLIC_URL=
# Optional custom endpoint (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=

# ------------------------------------------------------------------------------
# 6. Email (SMTP / IMAP) Configuration
# ------------------------------------------------------------------------------
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password

# ------------------------------------------------------------------------------
# 6. Gemini AI Document Reader
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_from_ai_studio
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 7. Frontend API URL
# ------------------------------------------------------------------------------
# When accessing from browser, points to the backend API endpoint
VITE_API_URL=http://localhost:8080
